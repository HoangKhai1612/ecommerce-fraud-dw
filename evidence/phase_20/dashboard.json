        "dataset_query": {
          "type": "native",
          "database": 2,
          "native": {
            "query": "SELECT p.transaction_id, p.is_fraud_actual, p.is_fraud_predicted, ROUND((p.fraud_probability * 100)::numeric, 2) AS fraud_probability_pct, f.transaction_amt FROM marts.predictions p JOIN marts.fact_transactions f ON f.transaction_id = p.transaction_id WHERE p.model_version = 'xgboost-v1-phase16' ORDER BY p.fraud_probability DESC LIMIT 50;"
          }
        },
