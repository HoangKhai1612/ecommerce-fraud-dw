# PostgreSQL configuration
# The authoritative Data Warehouse runs on the Windows PostgreSQL 18
# server (host port 5432). The docker-local instance in Docker Compose
# uses DOCKER_POSTGRES_PORT to avoid the conflict.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ecommerce_fraud_dw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# URI-encoded POSTGRES_PASSWORD for Airflow connection URLs (e.g. "@" -> "%40")
POSTGRES_PASSWORD_URI=change_me

# Read-only user for the AI Assistant (Phase 22)
POSTGRES_RO_USER=ai_assistant_ro
POSTGRES_RO_PASSWORD=change_me
AI_DB_USER=ai_assistant_ro
AI_DB_PASSWORD=change_me
AI_ALLOWED_SCHEMAS=marts

# Airflow config
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_WWW_USER_CREATE=true
AIRFLOW_PORT=8080

# FastAPI ML API config (Phase 21)
API_HOST=0.0.0.0
API_PORT=8000

# LLM / AI Assistant config
# Ollama runs natively on the Windows host; containers reach it via
# host.docker.internal:11434.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3
OPEN_API_KEY=

# Metabase config
METABASE_PORT=3000

# AI Assistant service port (Phase 22 container)
AI_ASSISTANT_PORT=8001

# Docker-local PostgreSQL instance host port (Phase 23)
DOCKER_POSTGRES_PORT=5434

# System paths
DATA_DIR=./data/raw
MODEL_DIR=./ml/models
